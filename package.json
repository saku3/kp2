{
  "name": "kp2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n ttyd,vite -c yellow,cyan \"npm:ttyd\" \"npm:vite\"",
    "vite": "vite",
    "ttyd": "sh scripts/ttyd.sh",
    "build": "tsc --noEmit && vite build",
    "start": "concurrently -k -n ttyd,vite -c yellow,cyan \"npm:ttyd\" \"vite preview\""
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
